#!/bin/sh
# Rejects commit messages that do not follow Conventional Commits.
# CI derives the release version from these prefixes (see AGENTS.md, Section 4).

subject=$(head -n 1 "$1")

case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]+\))?!?: .+'

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  echo "commit-msg: subject is not a Conventional Commit:" >&2
  echo "  $subject" >&2
  echo "Expected: <type>(<scope>)!: <description>, e.g. 'fix(timer): restore elapsed time'." >&2
  exit 1
fi
